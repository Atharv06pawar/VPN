# ==============================================================================
# BharatTunnel 🇮🇳 - Environment Configuration Template
# DO NOT COMMIT PRODUCTION SECRETS TO SOURCE CONTROL
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://bharat:tunnel_secret@localhost:5432/bharattunnel?schema=public

# Authentication & Cryptographic Secrets (Minimum 32 random characters for production)
JWT_SECRET=dev_jwt_secret_must_be_over_32_characters_long_for_security_12345
SESSION_SECRET=dev_session_secret_must_be_over_32_characters_long_for_sec_12345
COOKIE_SECRET=dev_cookie_secret_must_be_over_32_characters_long_for_sec_12345

# WireGuard India Gateway Configuration
# In production, VPN_SERVER_HOST must be the Indian VPS public IPv4 address
VPN_SERVER_HOST=203.0.113.1
VPN_SERVER_PORT=51820
VPN_SERVER_PUBLIC_KEY=YWRtaW4td2ctcHViLWtleS1zYW1wbGUtZGF0YS0xMjM0NTY3OA==
VPN_NETWORK=10.50.0.0/24
VPN_GATEWAY_IP=10.50.0.1
VPN_DNS_SERVER=10.50.0.1,1.1.1.1
VPN_INTERFACE=wg0

# WireGuard Driver: 'system' for production Linux with /usr/bin/wg; 'mock' for local dev & testing
WIREGUARD_DRIVER=mock

# Service Policy & Resource Limits
MAX_DEVICES_PER_USER=2
MONTHLY_BANDWIDTH_GB=50
MAX_ACTIVE_SESSIONS=2

# Initial Admin Bootstrap
ADMIN_EMAIL=admin@bharattunnel.in
ADMIN_INITIAL_PASSWORD=BharatTunnelAdmin2026!
